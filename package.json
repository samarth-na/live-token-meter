{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "live-token-meter",
  "version": "0.1.0",
  "description": "Live tokens-per-second (TPS) readout in the OpenCode 2.0 TUI prompt footer",
  "type": "module",
  "license": "MIT",
  "main": "./dist/tui.js",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "oc-plugin": [
    "tui"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build && bun run test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17317",
    "@opentui/solid": "0.5.1",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/client": "0.0.0-next-17317",
    "@opencode-ai/theme": "0.0.0-next-17317",
    "@opentui/core": "0.5.1",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tokens",
    "tps",
    "token-usage",
    "sidebar"
  ],
  "homepage": "https://github.com/samarth-na/live-token-meter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samarth-na/live-token-meter.git"
  },
  "bugs": {
    "url": "https://github.com/samarth-na/live-token-meter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
